# Copy to backend/.env and adjust.
# PostgreSQL (recommended). Without it a local SQLite file in backend/data is used.
# FS_DATABASE_URL=postgresql+psycopg2://followsense:followsense@localhost:5432/followsense
# FS_DATA_DIR=./data
# FS_YOLO_MODEL=yolo11n.pt      # yolo11s.pt / yolo11m.pt are more accurate but slower
# FS_DEVICE=                    # "" auto, "cpu", or a CUDA index like "0"
# FS_MAX_PARALLEL_JOBS=2
# FS_CORS_ORIGINS=*
